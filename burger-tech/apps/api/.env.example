# Copie este arquivo para ".env" e ajuste os valores antes de rodar a API.

# Segredos usados para assinar os JWTs — troque por valores aleatórios longos
# antes de considerar isto pronto para produção (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_CLIENTE=troque-este-segredo-de-cliente
JWT_SECRET_ADMIN=troque-este-segredo-de-administrador

JWT_ALGORITHM=HS256
JWT_EXPIRA_MINUTOS_CLIENTE=1440
JWT_EXPIRA_MINUTOS_ADMIN=480

# Caminho do arquivo do banco SQLite (relativo à pasta apps/api)
DATABASE_PATH=database/burger_tech.db

# Origens permitidas para CORS, separadas por vírgula (o dev server do Vite roda em 5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
